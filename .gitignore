# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
.expo/


# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv


# Local env overrides (e.g. frontend/.env.local pointing at a local API)
.env*.local

# Deploy staging copies and generated env files (hold secrets)
deploy/.stage/
deploy/*.env

# Browser-test snapshots
.playwright-mcp/

# Secrets: the backend .env holds the database password, MASTER_ADMIN_KEY and API keys.
# NOTE: ignoring does not untrack a file git already tracks — see the security notes.
backend/.env

# Packaged copies of the project/deploy bundles (large, and can contain .env)
*.zip

# Backups of old env files (hold secrets)
backend/.env.*
!backend/.env.example
