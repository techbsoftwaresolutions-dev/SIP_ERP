# Copy to backend/.env and fill in. Never commit the real .env (it holds secrets).
# On Hostinger these are set in hPanel -> the API app -> Environment variables.

# Database (MongoDB Atlas). Include the default database name in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/siperp_crm?retryWrites=true&w=majority&appName=SIPERP

PORT=5000

# Protects the platform admin API. Use a long random string.
MASTER_ADMIN_KEY=

# The domain clients' workspaces live under: a client "acme" is opened at
# acme.<APP_BASE_DOMAIN>. REQUIRED on the live server, or invite and
# reset-password links cannot point at a client's own address.
APP_BASE_DOMAIN=siperp.in

# Optional: one fixed frontend address, used for links when no client is known.
# APP_ORIGIN=

# Optional
GEOIP_ENABLED=true
# ANTHROPIC_API_KEY=            (the AI assistant shows "coming soon" without it)
# GST_LOOKUP_URL=               (address auto-fill from a GST number; see services/gstLookup.js)
# GST_LOOKUP_KEY=
