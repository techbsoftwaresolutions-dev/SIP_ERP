        "start",
        "--web",
        "--port",
        "8083"
      ],
      "cwd": "mobile",
      "port": 8083,
      "env": {
        "API_BASE_URL": "http://localhost:5000",
        "BROWSER": "none",
        "CI": "1"
      }
    },
