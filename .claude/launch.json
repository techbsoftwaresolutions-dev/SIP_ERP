{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "siperp-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "backend",
      "port": 5000
    },
    {
      "name": "siperp-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
